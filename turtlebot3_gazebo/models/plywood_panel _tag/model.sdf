<?xml version='1.0'?>
<sdf version="1.4">
    <model name="plywood_panel_tag">
        <static>true</static>

        <link name="main">
            <pose>0 0 0 0 0 0</pose>
            <collision name="collision">
                <pose>0.0 -0.5 0.3 -1.571 0 -1.571</pose>
                <geometry>
                    <box>
                        <size>0.98 0.6 0.02</size>
                    </box>
                </geometry>
            </collision>

            <visual name="visual">
                <!-- offset origin to align to the center of one grid edge and rotate to vertical position -->
                <pose>0.01 -0.01 0 0 -1.571 0</pose>
                <geometry>
                    <mesh>
                        <scale>1.0 1.0 1.0</scale>
                        <!-- measures 0.98 x 0.6 x 0.02 mt, origin is at one corner of the panel -->
                        <uri>model://plywood_panel/meshes/plywood.dae</uri>
                    </mesh>
                </geometry>
            </visual>

            <!-- AR Tag visual -->
            <visual name="ar_tag">
                <!-- Place tag at center of one face, slightly offset in z to avoid z-fighting -->
                <pose>0 0 0.011 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.15 0.15 0.001</size>
                    </box>
                </geometry>
                <material>
                    <script>
                        <uri>model://plywood_panel _tag/textures</uri>
                        <name>5x5_1000-23.png</name>
                    </script>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                </material>
            </visual>
        </link>

    </model>
</sdf>